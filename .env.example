# Copy to server/.env and fill in real values. Never commit the real file.

# --- API ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sen371?retryWrites=true&w=majority

# --- Auth ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-with-a-different-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Payment gateway (Milestone 3) ---
# The mock gateway lives in server/src/gateway/ and is started by `npm start`
# on its own port, so there is no second service to run. The API still calls
# it over HTTP - these defaults already match, so nothing here needs changing.
# PAYMENT_PROVIDER=mock          # "mock" = real HTTP call | "stub" = in-process, for tests
# PAYMENT_EMBEDDED=true          # false = do not start it; host it yourself
# PAYMENT_GATEWAY_PORT=5001
# PAYMENT_API_URL=http://localhost:5001
# PAYMENT_API_KEY=dev-gateway-key   # must equal GATEWAY_API_KEY the gateway reads
# PAYMENT_TIMEOUT_MS=5000
# PAYMENT_CURRENCY=ZAR

# --- Client (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api
