# Copy to server/.env and fill in real values. Never commit the real file.

# --- API ---
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sen371?retryWrites=true&w=majority

# --- Auth ---
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-with-a-different-value
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Client (Vite) ---
VITE_API_BASE_URL=http://localhost:5000/api
